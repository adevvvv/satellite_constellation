# Версии образов
VERSION=v1.0.0

# Порт сервера
SERVER_PORT=8080

# Порт клиента
MISSION_PORT=8081

# URL для связи
SERVER_URL=http://space-operations-system:8080

# Настройки healthcheck
HEALTHCHECK_INTERVAL=10s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=5
HEALTHCHECK_START_PERIOD=30s

# PostgreSQL
POSTGRES_DB=satellite_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# gRPC
GRPC_TELEMETRY_HOST=telemetry-service
GRPC_TELEMETRY_PORT=9091